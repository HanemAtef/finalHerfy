      {/* Users Table Card */}
      <div className="card space-y-4">
        <div className="flex flex-wrap items-center justify-between gap-3 pb-3 border-b border-neutral">
          {/* Role Filter Tabs */}
          <div className="flex gap-1.5">
            {[
              { key: 'all', label: 'الكل' },
