  return {
    paymentIntents: {
      retrieve: mockRetrieve,
      create: mockCreate,
    },
    webhooks: {
      constructEvent: jest.fn(),
    },
    __mockRetrieve: mockRetrieve,
    __mockCreate: mockCreate,
