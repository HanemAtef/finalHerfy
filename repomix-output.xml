export const sendMessage = createAsyncThunk(
  'chat/sendMessage',
  async ({ orderId, text }, { rejectWithValue }) => {
    try {
      const response = await messageService.sendMessage({ orderId, text });
      return { orderId, message: response.data.message || response.data };
    } catch (error) {
