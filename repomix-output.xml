});

// Mock TomTom to avoid network calls during order creation
jest.mock('../utils/tomtom', () => ({
  calculateRoute: jest.fn().mockResolvedValue({
    route: { summary: { travelTimeInSeconds: 600, lengthInMeters: 5000 } },
