                      ) : (
                        <span className="mt-1 block text-[10px] font-bold text-amber-600">غير مدفوع</span>
                      )
                    )}
                    {order.status === 'completed' && order.paymentStatus === 'paid' && (
                      <span className="mt-1 block text-[10px] font-bold text-emerald-600">تم الدفع ✓</span>
                    )}
