MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/harfey?retryWrites=true&w=majority
PORT=5000
JWT_SECRET=<generate a long random secret, e.g. `openssl rand -hex 32`>
JWT_EXPIRES_IN=15m
EMAIL_USER=<gmail address used to send OTP emails>
EMAIL_PASS=<gmail app password>
TOMTOM_API_KEY=<tomtom api key>

# Rate Limiting (window in minutes, max = requests per window per IP)
RATE_LIMIT_GLOBAL_WINDOW=15
RATE_LIMIT_GLOBAL_MAX=60
RATE_LIMIT_AUTH_WINDOW=15
RATE_LIMIT_AUTH_MAX=10

# Matching Algorithm Weights (must sum to 1.0)
MATCHING_DISTANCE_WEIGHT=0.4
MATCHING_RATING_WEIGHT=0.4
MATCHING_ACCEPTANCE_WEIGHT=0.2

# ETA recalculation interval while order is in-progress (seconds)
ETA_RECALCULATION_INTERVAL_SEC=60

# Dispute SLA: hours before an unresolved dispute is auto-escalated
DISPUTE_SLA_HOURS=48
