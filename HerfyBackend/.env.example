# Copy this file to .env and fill in real values. NEVER commit or ship .env.
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/harfey?retryWrites=true&w=majority
# PORT=8000
# JWT_SECRET=<generate a long random secret, e.g. `openssl rand -hex 32`>
# JWT_EXPIRES_IN=15m
# EMAIL_USER=<gmail address used to send OTP emails>
# EMAIL_PASS=<gmail app password>
# TOMTOM_API_KEY=<tomtom api key>
# STRIPE_SECRET_KEY=sk_test_<your_stripe_secret_key>
# STRIPE_PUBLISHABLE_KEY=pk_test_<your_stripe_publishable_key>
# STRIPE_WEBHOOK_SECRET=whsec_<your_webhook_secret>
# STRIPE_PRICE_MONTHLY=price_<monthly_price_id>
# STRIPE_PRICE_YEARLY=price_<yearly_price_id>
